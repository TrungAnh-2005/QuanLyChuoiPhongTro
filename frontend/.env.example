# Các biến VITE_* được đưa vào bundle và được trình duyệt đọc; không đặt bí mật tại đây.
VITE_API_BASE_URL=/api
# Proxy Vite dùng cho phát triển local.
GATEWAY_URL=http://localhost:8080
# Thông tin ngân hàng công khai hiển thị khi tạo QR (tùy chọn).
VITE_BANK_ACCOUNT=
VITE_BANK_CODE=
VITE_BANK_ACCOUNT_NAME=

# Vào thẳng màn hình nghiệp vụ, không cần đăng nhập.
VITE_TEST_MODE=true
