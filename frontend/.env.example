# ==============================================================================
# HỆ THỐNG QUẢN LÝ CHUỖI PHÒNG TRỌ (RENTAL MANAGEMENT SYSTEM)
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO FRONTEND (.env.example) - AN TOÀN ĐỂ PUSH LÊN GITHUB
# Hướng dẫn: Sao chép file này thành .env hoặc .env.local trong thư mục frontend/:
#   cp frontend/.env.example frontend/.env
# ==============================================================================

# Backend API Base URL (API Gateway)
VITE_API_BASE_URL=http://localhost:8080

# AI Vision & OCR (Google Gemini API cho Frontend)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
