# ==============================================================================
# HỆ THỐNG QUẢN LÝ CHUỖI PHÒNG TRỌ (RENTAL MANAGEMENT SYSTEM)
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example) - AN TOÀN ĐỂ PUSH LÊN GITHUB
# Hướng dẫn: Sao chép file này thành .env và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# ==============================================================================

# Database Settings (MySQL 8.0)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_USER=your_db_username_here
MYSQL_PASSWORD=your_db_password_here

# Message Broker Settings (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=your_rabbitmq_username_here
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password_here
RABBITMQ_EXCHANGE=rental.topic.exchange

# Service Discovery & Gateway
EUREKA_SERVER_PORT=8761
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
GATEWAY_PORT=8080

# Microservices Ports
AUTH_SERVICE_PORT=8081
ROOM_SERVICE_PORT=8082
TENANT_SERVICE_PORT=8083
CONTRACT_SERVICE_PORT=8084
METER_SERVICE_PORT=8085
BILLING_SERVICE_PORT=8086
PAYMENT_SERVICE_PORT=8087
MAINTENANCE_SERVICE_PORT=8088
NOTIFICATION_SERVICE_PORT=8089
REPORT_SERVICE_PORT=8090
AI_SERVICE_PORT=8091

# Payment Gateway Settings (VNPay Sandbox)
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# Payment Gateway Settings (MoMo Sandbox)
MOMO_PARTNER_CODE=your_momo_partner_code_here
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo-return
MOMO_IPN_URL=http://localhost:8087/api/payments/momo/ipn

# AI Vision & OCR (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# JWT Security (Key HMAC-SHA ít nhất 256 bits)
JWT_SECRET_KEY=your_jwt_secret_key_at_least_256_bits_here_example_hex_or_base64
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8080
