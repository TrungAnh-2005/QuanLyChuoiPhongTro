# Docker Compose đọc file .env tại thư mục gốc.
# Spring Boot đọc .env tại thư mục chạy; khi chạy từ gốc, .env gốc ưu tiên hơn backend/.env.
# Giá trị database mặc định khớp với cấu hình local hiện có; không đổi mật khẩu volume đã khởi tạo.
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=rental_user
MYSQL_PASSWORD=rental_secret

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=rental_rabbit
RABBITMQ_DEFAULT_PASS=rental_rabbit_secret

EUREKA_SERVER_PORT=8761
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
GATEWAY_PORT=8080
# Không đặt SERVER_PORT chung: mỗi microservice có cổng riêng.

# Base64 của ít nhất 32 byte ngẫu nhiên. Auth và Gateway phải dùng cùng giá trị.
JWT_SECRET_KEY=replace_with_base64_encoded_random_32_byte_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Bỏ trống nếu chưa có tài khoản nhà cung cấp. Chỉ đặt các khóa này ở backend.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
SEPAY_API_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo-return
MOMO_IPN_URL=http://localhost:8080/api/payments/momo/ipn

# Bản test nghiệp vụ: Gateway không yêu cầu JWT. Đặt false khi làm phân quyền.
APPLICATION_TEST_MODE=true

# Giới hạn JVM cho môi trường test nhiều service trên cùng máy.
JAVA_OPTS=-Xms32m -Xmx128m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC -XX:ActiveProcessorCount=2

# Tách riêng tài nguyên bản test khỏi MySQL đang chạy trên cổng 3306.
MYSQL_VOLUME_NAME=rental_backend_test_mysql_v1
RABBITMQ_VOLUME_NAME=rental_backend_test_rabbitmq_v1
RENTAL_NETWORK_NAME=rental-backend-test-network
